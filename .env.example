APP_NAME="neoskin-rs"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8765

# 32-byte AES-256 key (URL-safe base64, no padding).
# 生成：suprnova key:generate
APP_KEY=

SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# SQLite（默认）：自动创建 database.sqlite
DATABASE_URL=sqlite://database.sqlite

# PostgreSQL / MySQL 示例：
# DATABASE_URL=postgres://user:pass@localhost:5432/neoskin
# DATABASE_URL=mysql://user:pass@localhost:3306/neoskin

SECURITY_HEADERS=balanced
SECURITY_HEADERS_CSP_REPORT_ONLY=false
SECURITY_HEADERS_HSTS_PRELOAD=false

# 本地 HTTP 开发：false；生产 HTTPS：true（默认）
SESSION_SECURE=false

# 与 PHP 版一致的会话 cookie 名
SESSION_COOKIE=blessing_skin_session
